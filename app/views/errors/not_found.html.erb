<% content_for :title, "Not found · Tastatur" %>
<div class="shell max-w-xl py-20 text-center">
  <p class="figure text-signal">404</p>
  <h1 class="text-xl font-semibold mt-4">That page does not exist.</h1>
  <p class="text-sm text-ink-2 mt-3">
    It may have been deleted, or it may belong to an account you are not a member of — we do not
    distinguish between the two on purpose.
  </p>
  <div class="mt-8"><%= link_to "Back to your sites", sites_path, class: "btn" %></div>
</div>
