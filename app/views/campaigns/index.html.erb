<% content_for :title, "Campaigns · Tastatur" %>

<div class="shell max-w-5xl">
  <div class="flex flex-wrap items-end justify-between gap-4 mb-8 pt-5 rule-heavy">
    <div class="mt-5">
      <h1 class="text-2xl font-semibold">Campaigns</h1>
      <p class="label mt-2">
        <%= pluralize(@campaigns.size, "campaign") %>
        <% if @sections.any? %>
          <span class="mx-2">·</span><%= pluralize(@sections.size, "site") %>
        <% end %>
      </p>
    </div>

    <%# A PRESET, RESOLVED PER SITE. There is no "all time" option and no custom
        range: all-time would mean scanning the raw hypertable with no bound (the
        aggregates carry no UTM columns, so the trick Analytics::SiteTotals uses
        on the sites index is not available here), and a custom range is two
        absolute dates resolved in a site's own zone, which several sites cannot
        agree on. See CampaignsController. -%>
    <% if @sections.any? %>
      <div class="segmented">
        <% CampaignsController::PERIODS.each do |key| %>
          <%= link_to Analytics::Period::PRESETS[key].sub("Last ", ""),
                      campaigns_path(period: key),
                      class: "segment", "aria-current": (@period_key == key).to_s,
                      data: { analytics_event: "Period Changed",
                              analytics_props: { period: key, view: "all_campaigns" } } %>
        <% end %>
      </div>
    <% end %>
  </div>

  <% if @sites.empty? %>
    <%# A campaign link points at a page on a site this instance measures — that
        is validated, not advisory (CampaignLink#destination_is_a_page_on_this_site)
        — so there is nothing this screen could usefully offer somebody with no
        sites. It says which step is missing rather than listing nothing. -%>
    <div class="card card-body text-center py-14">
      <p class="font-semibold">Add a site first.</p>
      <p class="text-sm text-ink-2 mt-2 max-w-md mx-auto">
        A campaign link has to point at a page on a site you measure, so there is nothing to build
        until there is one.
      </p>
      <div class="mt-6">
        <%= link_to "Sites", sites_path, class: "btn btn-primary btn-sm" %>
      </div>
    </div>
  <% elsif @sections.empty? %>
    <div class="card card-body text-center py-14">
      <p class="font-semibold">No campaigns yet.</p>
      <p class="text-sm text-ink-2 mt-2 max-w-lg mx-auto">
        A campaign is a name for something you are about to promote, and a link for each place you
        will post it. Build one on the site it points at, and what the links bring in appears here.
      </p>
      <div class="mt-6 flex flex-wrap justify-center gap-2">
        <% @sites.each do |site| %>
          <%= link_to site.domain, site_campaigns_path(site), class: "btn btn-sm" %>
        <% end %>
      </div>
    </div>
  <% end %>

  <%# ONE CARD PER SITE, and the grouping is not decoration. A period preset
      resolves against ONE site's timezone (Analytics::Period), so the window
      these figures cover is a property of the site — which means it can be
      stated once, on the group, rather than being quietly different from row to
      row inside one flat table. It is also why there is no total anywhere on
      this page: adding a Berlin site's "last 30 days" to a Kolkata site's is
      two different windows, and `visitors` and `visits` are COUNT(DISTINCT)
      besides (§8). -%>
  <% @sections.each_with_index do |section, index| %>
    <% site = section.site %>
    <div class="card <%= "mt-6" unless index.zero? %>">
      <div class="card-head flex flex-wrap items-end justify-between gap-3">
        <div>
          <h2 class="text-sm font-semibold"><%= site.domain %></h2>
          <p class="text-[12px] text-muted mt-1">
            <%= section.period.label %><span class="mx-1.5">·</span><%= site.timezone %>
          </p>
        </div>
        <%# Into the site's own campaigns screen, which is where a campaign is
            built, edited, and read link by link. This page is the directory; that
            page is the work. -%>
        <%= link_to "Build a link", site_campaigns_path(site), class: "label hover:text-ink",
                    data: { analytics_event: "Campaigns Opened",
                            analytics_props: '{"source":"all_campaigns"}' } %>
      </div>

      <div class="bar-row label border-b border-rule">
        <span>Campaign</span>
        <span class="flex gap-3 sm:gap-6">
          <span class="w-14 sm:w-24 text-right"><span class="sm:hidden">Visit.</span><span class="hidden sm:inline">Visitors</span></span>
          <span class="w-12 sm:w-20 text-right">Visits</span>
          <span class="w-12 sm:w-20 text-right">Views</span>
        </span>
      </div>

      <%# Scaled against the busiest campaign IN THIS SITE, for the same reason
          the per-site screen scales a link against its own campaign: there is no
          denominator that spans two sites' windows, so a bar drawn against one
          would be inventing one. -%>
      <% top = section.rows.filter_map { |row| row.total&.visitors }.max.to_i %>
      <% section.rows.each do |row| %>
        <% total = row.total %>
        <%# Straight into the dashboard filtered to this campaign, which is where
            every other question about it is answered — which pages, which
            countries, which goals. Carries this site's own resolved window, so
            the dashboard opens on the period the row was measured over. -%>
        <%= link_to site_path(site, utm_campaign: row.campaign.utm_campaign, **section.period.to_param),
                    class: "bar-row" do %>
          <span class="bar-fill" style="width: <%= top.positive? && total ? (total.visitors * 100.0 / top).round(1) : 0 %>%"></span>
          <span class="bar-label min-w-0">
            <span class="font-medium"><%= row.campaign.name %></span>
            <span class="block text-[12px] text-muted mt-0.5 truncate">
              <span class="num"><%= row.campaign.utm_campaign %></span>
              <span class="mx-1.5">·</span><%= pluralize(row.campaign.campaign_links.size, "link") %>
            </span>
          </span>
          <span class="flex gap-3 sm:gap-6 items-center num shrink-0">
            <span class="w-14 sm:w-24 text-right"><%= total ? metric_number(total.visitors) : "—" %></span>
            <span class="w-12 sm:w-20 text-right"><%= total ? metric_number(total.visits) : "—" %></span>
            <span class="w-12 sm:w-20 text-right"><%= total ? metric_number(total.pageviews) : "—" %></span>
          </span>
        <% end %>
      <% end %>
    </div>
  <% end %>

  <% if @sections.any? %>
    <p class="text-[12px] text-muted mt-4">
      Each site is measured over its own window, in its own timezone, and nothing here is added
      across sites — the same figures appear on each site's own campaigns screen. A dash means
      nothing has been recorded: either nobody followed the campaign, or too few people did for
      the row to clear that site's privacy threshold.
    </p>
    <%# NO WITHHELD COUNT HERE, unlike a breakdown panel, and that is the point of
        the sentence above. Every campaign the account has built is named on this
        page whether or not it has a figure, so "2 withheld" beside three dashes
        would say "somebody came, fewer than k of them" about two campaigns and
        leave the reader to work out which. The dash conflating "nobody" with
        "too few" IS the protection. -%>
  <% end %>
</div>
