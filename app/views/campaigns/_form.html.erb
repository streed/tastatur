<%# THE "WHAT IS THIS FOR?" FORM. A campaign is a name and a tag, and the links
    under it are how it was distributed — so the builder takes several at once
    rather than making somebody create the campaign and then come back for each
    channel.

    Locals:
      campaign  the record being built or edited

    Reads the site off the record rather than off @site: this partial renders on
    the index (where a controller ivar would be set) and on the edit screen
    (where it would not), and the campaign knows which site it is on either way.

    The nested list is one level deep, which is the ordinary nested-form case:
    each row is a link, none of them contains another list. (§9's warning about
    nesting the controller inside itself is about the funnel form, where a step
    holds alternatives — nothing here does that.) -%>
<%= form_with model: campaign,
              url: campaign.persisted? ? campaign_path(campaign) : campaigns_path(site: campaign.site.public_token),
              class: "space-y-6",
              data: { analytics_event: ("Campaign Created" unless campaign.persisted?) } do |f| %>
  <%= f.error_summary %>

  <div class="card card-body space-y-6">
    <%= f.field :name, "What is this for?", placeholder: "August launch",
                autofocus: !campaign.persisted?,
                hint: "The push these links belong to. Yours, not the visitor's." %>

    <%# FILLS ITSELF IN from the name, and stays editable anyway: a campaign
        already running in an ad platform has a tag that must be matched
        exactly, and the derived one would be wrong. -%>
    <%= f.field :utm_campaign, "Tag", placeholder: "august-launch",
                hint: "What every link below carries as utm_campaign, and what the report groups by. " \
                      "Left blank, it is made from the name." %>
  </div>

  <% if campaign.persisted? %>
    <%# Links are added and removed from the section on the campaigns screen once
        the campaign exists, so this form stops at the heading. Two places to
        edit one list is how the two get out of step. -%>
    <%= f.actions "Save campaign",
                  cancel_to: campaigns_path(site: campaign.site.public_token),
                  destroy_to: campaign_path(campaign),
                  destroy_confirm: "Delete this campaign and its links? The visits they already " \
                                   "brought stay counted — they move to the list of campaigns not built here." %>
  <% else %>
    <div class="card" data-controller="nested-form"
         data-nested-form-label-value="Link"
         data-nested-form-min-value="1">
      <div class="card-head">
        <h2 class="text-sm font-semibold">Links</h2>
        <span class="label">
          <span data-nested-form-target="count"><%= campaign.campaign_links.size %></span>
          · one per channel
        </span>
      </div>

      <div class="card-body space-y-6 divide-y divide-rule" data-nested-form-target="rows">
        <%= f.fields_for :campaign_links do |link| %>
          <%= render "campaign_links/fields", f: link, tag: campaign.utm_campaign %>
        <% end %>
      </div>

      <%# A browser never submits the contents of a <template>, so this blank row
          cannot reach the server on its own. child_index gives it the
          placeholder the controller swaps for a unique index. -%>
      <template data-nested-form-target="template">
        <%= f.fields_for :campaign_links,
                         CampaignLink.new(destination_url: "https://#{campaign.site.domain}/"),
                         child_index: "NEW_RECORD" do |link| %>
          <%= render "campaign_links/fields", f: link, tag: campaign.utm_campaign %>
        <% end %>
      </template>

      <%# Once for the whole form, outside the <template> above: every row's
          pickers read this one payload by id. -%>
      <div class="px-5 pb-4">
        <%= render "campaigns/values_payload", campaign_values: campaign_values %>
      </div>

      <div class="px-5 py-4 border-t border-rule flex items-center justify-between gap-4">
        <button type="button" class="btn btn-sm"
                data-action="nested-form#add" data-nested-form-target="addButton"
                data-analytics-event="Campaign Link Added"
                data-analytics-props='{"context":"new"}'>
          Add another link
        </button>
        <p class="text-[12px] text-muted">
          One link per place you post it. They all carry the tag above, which is what puts them
          in one row of the report together.
        </p>
      </div>
    </div>

    <%= f.actions "Create campaign", cancel_to: campaigns_path(site: campaign.site.public_token) %>
  <% end %>
<% end %>
