<% content_for :title, "Password required · Tastatur" %>

<div class="shell max-w-md py-20">
  <div class="pt-5 rule-heavy">
    <h1 class="text-xl font-semibold mt-5">This dashboard is password protected</h1>
    <p class="text-sm text-ink-2 mt-2">Ask whoever shared the link for the password.</p>
  </div>

  <%= form_with url: unlock_shared_dashboard_path(@shared_link.slug), scope: :unlock,
                class: "card card-body mt-8 space-y-5" do |f| %>
    <%= f.field :password, "Password", as: :password_field, name: "password",
                autofocus: true, autocomplete: "current-password" %>
    <div class="pt-1">
      <%= f.submit "View dashboard", class: "btn btn-primary w-full justify-center" %>
    </div>
  <% end %>
</div>
