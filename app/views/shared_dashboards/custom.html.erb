<% content_for :title, "#{@site.domain} · shared dashboard" %>
<div class="shell">
  <div class="flex flex-wrap items-end justify-between gap-4 mb-6">
    <div>
      <div class="flex items-center gap-3">
        <h1 class="text-2xl font-semibold"><%= @report.dashboard.name %></h1>
        <% if @report.realtime.positive? %>
          <span class="flex items-center gap-2 label">
            <span class="w-1.5 h-1.5 bg-signal inline-block" aria-hidden="true"></span>
            <%= pluralize(@report.realtime, "current visitor") %>
          </span>
        <% end %>
      </div>
      <p class="label mt-2">
        <%= @site.domain %><span class="mx-2">·</span><%= @period.label %>
        <span class="mx-2">·</span><%= @site.timezone %>
      </p>
    </div>
    <div class="segmented">
      <% %w[today 7d 30d 90d].each do |key| %>
        <%= link_to Analytics::Period::PRESETS[key].sub("Last ", ""),
                    shared_dashboard_path(@shared_link.slug, period: key),
                    class: "segment", "aria-current": (@period.key == key).to_s %>
      <% end %>
    </div>
  </div>

  <%# editable: false — the empty states must not offer an edit page to an
      anonymous reader. Widgets are never drillable, so there is no filter
      surface here at all; the only filters at work are the ones the
      dashboard's author saved, and each widget states its own. %>
  <%= render "sites/dashboards/widgets", site: @site, report: @report, editable: false %>
</div>
