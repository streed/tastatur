<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "Tastatur" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="application-name" content="Tastatur">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%# This app measures other people's sites; it does not measure its own
        visitors with third-party anything. No external fonts, no CDN, no tag
        manager — everything referenced below is served from this origin. %>
    <meta name="referrer" content="strict-origin-when-cross-origin">

    <%= yield :head %>

    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <%= render "layouts/tracker" %>
  </head>

  <%# One analytics controller for the whole application, listening from the
      body rather than from each control. Delegating means an element annotated
      with data-analytics-event reports itself wherever it is, including inside a
      Turbo Frame that was swapped in after this element connected.

      The same element also carries a step the server had to observe on the
      browser's behalf — a sign-in that was actually accepted — because nothing
      the visitor does on the page that follows it says so. Empty on every other
      request. See SelfMeasurement. -%>
  <body class="min-h-screen flex flex-col"
        data-controller="analytics"
        data-action="click->analytics#track turbo:submit-end->analytics#track"
        <%= tag.attributes(SelfMeasurement.take(session)) %>>
    <header class="border-b border-rule bg-surface">
      <div class="shell flex items-center justify-between h-14">
        <div class="flex items-center gap-8">
          <%= link_to root_path, class: "flex items-baseline gap-2" do %>
            <span class="text-[15px] font-bold tracking-[0.24em] uppercase">Tastatur</span>
            <span class="w-2 h-2 bg-signal inline-block translate-y-[-1px]" aria-hidden="true"></span>
          <% end %>

          <% if user_signed_in? && current_account %>
            <nav class="hidden sm:flex items-center gap-1">
              <%= link_to "Sites", sites_path, class: "btn btn-quiet btn-sm" %>
              <%= link_to "Account", account_path, class: "btn btn-quiet btn-sm" %>
              <%# Hidden when self-hosted: an operator running this on their own
                  hardware should never see a plan screen, let alone a paywall. Also
                  hidden from anyone who cannot open it — billing is owner-only, so
                  offering an admin or a viewer a link that can only redirect them
                  back with "you do not have access" is a dead end. Same reasoning as
                  the "Add a site" button in sites/index. %>
              <% if !Tastatur.self_hosted? && policy(current_account).manage_billing? %>
                <%= link_to "Plan", billing_path, class: "btn btn-quiet btn-sm" %>
              <% end %>
              <%= link_to "Docs", docs_path, class: "btn btn-quiet btn-sm" %>
            </nav>
          <% end %>
        </div>

        <div class="flex items-center gap-3">
          <% unless user_signed_in? %>
            <% unless Tastatur.self_hosted? %>
              <%= link_to "Pricing", pricing_path, class: "btn btn-quiet btn-sm" %>
            <% end %>
            <%= link_to "Docs", docs_path, class: "btn btn-quiet btn-sm" %>
          <% end %>
          <% if user_signed_in? %>
            <span class="label hidden md:inline"><%= current_user.email %></span>
            <%= button_to "Sign out", destroy_user_session_path, method: :delete,
                          class: "btn btn-quiet btn-sm" %>
          <% else %>
            <%= link_to "Sign in", new_user_session_path, class: "btn btn-quiet btn-sm" %>
            <% if Tastatur.allow_signup? %>
              <%= link_to "Get started", new_user_registration_path, class: "btn btn-primary btn-sm" %>
            <% end %>
          <% end %>
        </div>
      </div>
    </header>

    <% if flash.any? %>
      <div class="shell mt-6">
        <% flash.each do |type, message| %>
          <div class="notice <%= "border-signal text-ink" if type.to_s.in?(%w[alert error]) %>" role="status">
            <%= message %>
          </div>
        <% end %>
      </div>
    <% end %>

    <main class="flex-1 py-8">
      <%= yield %>
    </main>

    <%# The login-cookie disclosure, shown only where members of the public can
        acquire one. See the partial for why it is conditional and why it is a
        statement rather than a consent gate. %>
    <div class="shell"><%= render "shared/cookie_notice" %></div>

    <footer class="border-t border-rule mt-16">
      <div class="shell py-6 flex flex-wrap items-center justify-between gap-4 text-[12px] text-muted">
        <span>
          <%# AGPL-3.0 is a LINK, not a label, and that matters more here than it
              usually would. Section 13 obliges an operator who lets people use this
              over a network to offer them the corresponding source, and the tracker
              banner — the one pointer that reaches every visitor of every measured
              site — now names tastatur.dev rather than the repository. So this is
              where source discovery has to actually happen. -%>
          Tastatur <%= Tastatur.version %> · cookieless analytics ·
          <%= link_to "AGPL-3.0", Tastatur.maintainer[:source],
                      class: "hover:text-ink underline", rel: "noopener" %><br class="sm:hidden">
          <span class="sm:before:content-['·'] sm:before:mx-2">Built by
            <%= link_to Tastatur.maintainer[:name], Tastatur.maintainer[:url],
                        class: "hover:text-ink underline", rel: "noopener" %></span>
        </span>
        <nav class="flex gap-5">
          <%= link_to "About", about_path, class: "hover:text-ink" %>
          <% unless Tastatur.self_hosted? %>
            <%= link_to "Pricing", pricing_path, class: "hover:text-ink" %>
          <% end %>
          <%= link_to "Docs", docs_path, class: "hover:text-ink" %>
          <%= link_to "Privacy", privacy_path, class: "hover:text-ink" %>
          <%= link_to "Your data", data_request_path, class: "hover:text-ink" %>
          <%= link_to "DPA", dpa_path, class: "hover:text-ink" %>
          <%= link_to "Policy", privacy_policy_path, class: "hover:text-ink" %>
          <%= link_to "Terms", terms_path, class: "hover:text-ink" %>
        </nav>
      </div>
    </footer>
  </body>
</html>
