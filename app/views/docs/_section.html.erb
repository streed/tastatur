<%# One documentation section: an anchored heading, optional lede, and body. %>
<section id="<%= id %>" class="scroll-mt-24 pt-10 first:pt-0">
  <h2 class="text-xl font-semibold tracking-[-0.02em]">
    <a href="#<%= id %>" class="hover:text-signal"><%= title %></a>
  </h2>
  <% if local_assigns[:lede].present? %>
    <p class="text-[15px] text-ink-2 mt-2.5 leading-relaxed max-w-2xl"><%= lede %></p>
  <% end %>
  <div class="mt-5 space-y-5"><%= yield %></div>
</section>
