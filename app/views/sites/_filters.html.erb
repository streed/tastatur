<% if filters.any? %>
  <div class="flex flex-wrap items-center gap-2 mb-6">
    <span class="label mr-1">Filtered by</span>

    <% filters.each do |key, value| %>
      <span class="chip">
        <span class="chip-key"><%= filters.label_for(key) %></span>
        <span class="font-semibold"><%= key == "country" ? country_name(value) : value %></span>
        <%# The dimension, never `value`, which is beside it on screen and is a
            path or a country belonging to this site's visitors. %>
        <%# `analytics_dimension`, not `key`: for a custom event property the key
            is "props:" plus a name the customer invented, which is their schema
            and not ours to record. See DashboardHelper#analytics_dimension. %>
        <%= link_to "×", remove_filter_url(site, key), class: "chip-x",
                    "aria-label": "Remove #{filters.label_for(key)} filter",
                    data: { analytics_event: "Filter Removed",
                            analytics_props: { dimension: analytics_dimension(key) } } %>
      </span>
    <% end %>

    <%# How many were discarded at once distinguishes backing out of one wrong
        turn from abandoning a whole line of enquiry. %>
    <%= link_to "Clear all", dashboard_url_for(site, filters: Analytics::Filters.new),
                class: "btn btn-quiet btn-sm",
                data: { analytics_event: "Filters Cleared",
                        analytics_props: { count: filters.applied.size } } %>
  </div>
<% end %>
