<% content_for :title, "#{@link.name} · #{@campaign.name} · Tastatur" %>

<div class="shell max-w-3xl">
  <div class="pt-5 rule-heavy mb-8">
    <h1 class="text-2xl font-semibold mt-5">Edit link</h1>
    <p class="label mt-2"><%= @campaign.name %><span class="mx-2">·</span><%= @campaign.utm_campaign %></p>
    <p class="text-sm text-ink-2 mt-2">
      Changing a value re-points this link at a different row. Visits already recorded stay under
      the values they arrived with, and any copy of the link already sent out still carries the old
      ones. The campaign's tag is not editable here — it belongs to the campaign, so changing it
      would silently move this link out of the group it is measured in.
    </p>
  </div>

  <%= form_with model: @link, url: site_campaign_link_path(@site, @campaign, @link), class: "card card-body space-y-6" do |f| %>
    <%= f.error_summary %>
    <%= render "sites/campaign_links/fields", f: f, tag: @campaign.utm_campaign %>
    <%= render "sites/campaigns/values_payload", campaign_values: campaign_values %>
    <%= f.actions "Save link",
                  cancel_to: site_campaigns_path(@site),
                  destroy_to: site_campaign_link_path(@site, @campaign, @link),
                  destroy_confirm: "Delete this link? The visits it already brought stay counted — " \
                                   "it moves to the list of campaigns not built here." %>
  <% end %>
</div>
