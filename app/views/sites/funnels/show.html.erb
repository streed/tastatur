<% content_for :title, "#{@funnel.name} · #{@site.domain}" %>

<div class="shell max-w-4xl">
  <div class="flex flex-wrap items-end justify-between gap-4 mb-8 pt-5 rule-heavy">
    <div class="mt-5">
      <h1 class="text-2xl font-semibold"><%= @funnel.name %></h1>
      <p class="label mt-2">
        <%= @site.domain %><span class="mx-2">·</span><%= @period.label %>
        <span class="mx-2">·</span><%= pluralize(@report.steps.size, "step") %>
        <span class="mx-2">·</span><%= distance_of_time_in_words(@funnel.window_seconds) %> to complete
      </p>
    </div>
    <div class="flex gap-3">
      <div class="segmented">
        <% %w[7d 30d 90d].each do |key| %>
          <%# Same event as the dashboard's own period control, told apart by
              `view`: a funnel is read over a different span than a traffic
              report, and one number for both would hide that. %>
          <%= link_to Analytics::Period::PRESETS[key].sub("Last ", ""),
                      site_funnel_path(@site, @funnel, period: key),
                      class: "segment", "aria-current": (@period.key == key).to_s,
                      data: { analytics_event: "Period Changed",
                              analytics_props: { period: key, view: "funnel" } } %>
        <% end %>
      </div>
      <%= link_to "Edit", edit_site_funnel_path(@site, @funnel), class: "btn btn-sm" %>
    </div>
  </div>

  <% if @funnel.window_exceeds_identity_lifetime? %>
    <%# Stated rather than silently undercounting. See Analytics::FunnelReport. %>
    <div class="notice mb-6">
      <strong>This funnel's window is longer than 24 hours.</strong>
      Visitor identifiers expire daily, so a visitor who completes the funnel across a day
      boundary cannot be followed and will not be counted. The numbers below are a floor, not an
      exact figure. Shortening the window to a day or less removes the ambiguity.
    </div>
  <% end %>

  <%# --- Summary -%>
  <div class="card mb-6">
    <%# Three across only from `sm`: a third of a phone's width is ~73px of
        content, which wraps the "Overall conversion" label onto three lines.
        Stacked cells get a hairline between them instead. %>
    <div class="grid grid-cols-1 sm:grid-cols-3">
      <% [["Entered", metric_number(@report.entered)],
          ["Completed", metric_number(@report.completed)],
          ["Overall conversion", "#{@report.overall_rate}%"]].each_with_index do |(label, value), i| %>
        <div class="px-5 py-5 <%= "grid-hairline" unless i.zero? %> <%= "border-t border-rule sm:border-t-0" unless i.zero? %>">
          <p class="label"><%= label %></p>
          <p class="figure mt-2.5"><%= value %></p>
        </div>
      <% end %>
    </div>
  </div>

  <%# --- Step chart. The bars live in _step_bars, shared with the funnel
      widget on custom dashboards. -%>
  <div class="card">
    <div class="card-head">
      <h2 class="text-sm font-semibold">Steps</h2>
      <span class="label">Visitors reaching each step</span>
    </div>
    <div class="card-body space-y-5 pt-6">
      <%= render "sites/funnels/step_bars", report: @report %>
    </div>
  </div>

  <p class="text-[12px] text-muted mt-4 max-w-2xl leading-relaxed">
    Steps are matched in order: each step is searched only in the window after the previous step
    was reached for that same visitor. A visitor who backtracks and returns still counts, which a
    naive "first time each step matched" query would miss. A step listing several alternatives is
    reached by whichever of them the visitor hits first.
  </p>

  <div class="mt-8">
    <%= link_to "All funnels", site_funnels_path(@site), class: "btn btn-quiet" %>
    <%= link_to "Dashboard", site_path(@site), class: "btn btn-quiet" %>
  </div>
</div>
