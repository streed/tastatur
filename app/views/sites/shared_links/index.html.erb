<% content_for :title, "Share links · #{@site.domain}" %>

<div class="shell max-w-3xl">
  <div class="pt-5 rule-heavy mb-8">
    <h1 class="text-2xl font-semibold mt-5">Share <%= @site.domain %></h1>
    <p class="text-sm text-ink-2 mt-2">
      A read-only dashboard anyone with the link can view. No account needed.
    </p>
  </div>

  <div class="notice mb-6">
    Anyone holding the link can see this site's statistics. The link is the only thing protecting
    it, so treat it as a secret, and revoke it rather than reusing it if that stops being true.
    Public dashboards always apply the site's privacy threshold and do not offer filters.
  </div>

  <%# The form comes BEFORE the list. This page is reached from a "Share" button,
      and the thing that button promises is a new link — putting the existing ones
      first means scrolling past them to do the one thing you came for, which is
      the problem this page already had one level up.

      The label, the password and the expiry all stay here. The label is written
      for a client — "Acme monthly" — and naming one in our analytics would be
      naming a customer's customer. -%>
  <% if policy(SharedLink.new(site: @site)).create? %>
    <%= form_with model: @shared_link, url: site_shared_links_path(@site),
                  class: "card card-body space-y-6",
                  data: { analytics_event: "Share Link Created" } do |f| %>
      <%= f.error_summary %>

      <h2 class="text-sm font-semibold">New share link</h2>

      <%= f.field :name, "Label", placeholder: "Client report" %>

      <% if @site.dashboards.any? %>
        <%# What the link exposes. A custom dashboard shares ONLY its own
            widgets — including any filters their author saved onto them, which
            each widget states on its face. -%>
        <%= f.field :dashboard_public_id, "What it shows", as: :select,
                    choices: [["The full dashboard", ""]] +
                             @site.dashboards.ordered.map { |dashboard| [dashboard.name, dashboard.public_id] },
                    hint: "A custom dashboard shares exactly its own widgets, nothing else." %>
      <% end %>

      <div class="grid sm:grid-cols-2 gap-4">
        <%= f.field :password, "Password (optional)", as: :password_field,
                    autocomplete: "new-password",
                    hint: "Leave blank for an open link." %>
        <%= f.field :expires_at, "Expires (optional)", as: :date_field,
                    hint: "After this date the link 404s." %>
      </div>

      <%= f.actions "Create link", cancel_to: site_path(@site), cancel_label: "Back to dashboard" %>
    <% end %>
  <% else %>
    <%# Viewing the links is member-and-up but creating one is admin-and-up, and
        this page is now offered from the dashboard header to everybody who can
        view it. Without this branch a member is shown a form whose only possible
        outcome is a bounce back here saying they do not have access. -%>
    <div class="card card-body text-sm text-ink-2">
      Publishing a dashboard is an admin action, because it makes this site's statistics
      readable by anyone holding the link. Ask an account admin to create one.
    </div>
  <% end %>

  <% if @shared_links.any? %>
    <div class="card mt-8">
      <div class="card-head"><h2 class="text-sm font-semibold">Existing links</h2></div>

      <% @shared_links.each do |link| %>
        <%# One clipboard controller per row: its source and label targets both
            have to live inside the element that declares it. -%>
        <div data-controller="clipboard"
             class="px-5 py-4 border-b border-rule last:border-b-0 flex items-start justify-between gap-4
                    <%= "bg-surface-2" if params[:created] == link.public_id %>">
          <div class="min-w-0">
            <p class="text-sm font-medium flex items-center gap-2">
              <%= link.name %>
              <% if link.expired? %>
                <%# Stated loudly. An expired link 404s, and showing its URL as
                    though it still worked sends people to an error page
                    wondering what they broke. %>
                <span class="text-[10px] font-semibold tracking-[0.12em] uppercase
                             text-negative border border-negative px-1.5 py-0.5">Expired</span>
              <% end %>
            </p>

            <p data-clipboard-target="source"
               class="text-[12px] mt-1 truncate <%= link.expired? ? "text-muted line-through" : "text-muted" %>">
              <%= shared_dashboard_url(link.slug) %>
            </p>

            <p class="label mt-1.5">
              <% if link.expired? %>
                Stopped working <%= time_ago_in_words(link.expires_at) %> ago
              <% else %>
                <%= link.password_protected? ? "Password protected" : "Open link" %>
                <% if link.dashboard %>
                  <span class="mx-2">·</span>shows “<%= link.dashboard.name %>”
                <% end %>
                <span class="mx-2">·</span><%= pluralize(link.view_count, "view") %>
                <% if link.expires_at %>
                  <span class="mx-2">·</span>expires <%= link.expires_at.to_date.to_fs(:long) %>
                <% end %>
              <% end %>
            </p>
          </div>

          <div class="flex items-center gap-2 shrink-0">
            <%# The URL was previously text you had to select by hand, which is the
                actual last step of "get me a share link". Not offered for an
                expired one: that URL 404s, so handing it to somebody is worse
                than making them ask. -%>
            <% unless link.expired? %>
              <button type="button" class="btn btn-sm" data-action="clipboard#copy"
                      data-analytics-event="Share Link Copied">
                <span data-clipboard-target="label">Copy link</span>
              </button>
            <% end %>

            <%= button_to(link.expired? ? "Delete" : "Revoke",
                          site_shared_link_path(@site, link), method: :delete,
                          class: "btn btn-quiet btn-sm text-negative",
                          form: { data: { turbo_confirm: link.expired? ? nil : "Revoke this link? Anyone using it loses access immediately." } }) %>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
