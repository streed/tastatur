<% content_for :title, "Share links · #{@site.domain}" %>

<div class="shell max-w-3xl">
  <div class="pt-5 rule-heavy mb-8">
    <h1 class="text-2xl font-semibold mt-5">Share <%= @site.domain %></h1>
    <p class="text-sm text-ink-2 mt-2">
      A read-only dashboard anyone with the link can view. No account needed.
    </p>
  </div>

  <div class="notice mb-6">
    Anyone holding the link can see this site's statistics. The link is the only thing protecting
    it, so treat it as a secret, and revoke it rather than reusing it if that stops being true.
    Public dashboards always apply the site's privacy threshold and do not offer filters.
  </div>

  <% if @shared_links.any? %>
    <div class="card mb-6">
      <% @shared_links.each do |link| %>
        <div class="px-5 py-4 border-b border-rule last:border-b-0 flex items-start justify-between gap-4">
          <div class="min-w-0">
            <p class="text-sm font-medium flex items-center gap-2">
              <%= link.name %>
              <% if link.expired? %>
                <%# Stated loudly. An expired link 404s, and showing its URL as
                    though it still worked sends people to an error page
                    wondering what they broke. %>
                <span class="text-[10px] font-semibold tracking-[0.12em] uppercase
                             text-negative border border-negative px-1.5 py-0.5">Expired</span>
              <% end %>
            </p>

            <p class="text-[12px] mt-1 truncate <%= link.expired? ? "text-muted line-through" : "text-muted" %>">
              <%= shared_dashboard_url(link.slug) %>
            </p>

            <p class="label mt-1.5">
              <% if link.expired? %>
                Stopped working <%= time_ago_in_words(link.expires_at) %> ago
              <% else %>
                <%= link.password_protected? ? "Password protected" : "Open link" %>
                <span class="mx-2">·</span><%= pluralize(link.view_count, "view") %>
                <% if link.expires_at %>
                  <span class="mx-2">·</span>expires <%= link.expires_at.to_date.to_fs(:long) %>
                <% end %>
              <% end %>
            </p>
          </div>

          <%= button_to(link.expired? ? "Delete" : "Revoke",
                        site_shared_link_path(@site, link), method: :delete,
                        class: "btn btn-quiet btn-sm text-negative shrink-0",
                        form: { data: { turbo_confirm: link.expired? ? nil : "Revoke this link? Anyone using it loses access immediately." } }) %>
        </div>
      <% end %>
    </div>
  <% end %>

  <%= form_with model: @shared_link, url: site_shared_links_path(@site),
                class: "card card-body space-y-6" do |f| %>
    <%= f.error_summary %>

    <h2 class="text-sm font-semibold">New share link</h2>

    <%= f.field :name, "Label", placeholder: "Client report" %>

    <div class="grid sm:grid-cols-2 gap-4">
      <%= f.field :password, "Password (optional)", as: :password_field,
                  autocomplete: "new-password",
                  hint: "Leave blank for an open link." %>
      <%= f.field :expires_at, "Expires (optional)", as: :date_field,
                  hint: "After this date the link 404s." %>
    </div>

    <%= f.actions "Create link", cancel_to: edit_site_path(@site), cancel_label: "Back to settings" %>
  <% end %>
</div>
