<% content_for :title, "#{@site.domain} · Tastatur" %>

<div class="shell">
  <%# --- Site header ---------------------------------------------------- %>
  <div class="flex flex-wrap items-end justify-between gap-4 mb-6">
    <div>
      <div class="flex items-center gap-3">
        <h1 class="text-2xl font-semibold"><%= @site.domain %></h1>
        <% if @report.realtime.positive? %>
          <span class="flex items-center gap-2 label" title="Visitors active in the last 5 minutes">
            <span class="w-1.5 h-1.5 bg-signal inline-block" aria-hidden="true"></span>
            <%= pluralize(@report.realtime, "current visitor") %>
          </span>
        <% end %>
      </div>
      <p class="label mt-2"><%= @period.label %><span class="mx-2">·</span><%= @site.timezone %></p>
    </div>

    <div class="flex flex-wrap items-center gap-3">
      <div class="segmented">
        <% %w[today 7d 30d 90d 12mo].each do |key| %>
          <%= period_link(@site, key, Analytics::Period::PRESETS[key].sub("Last ", "")) %>
        <% end %>
      </div>
      <%= link_to "Funnels", site_funnels_path(@site), class: "btn btn-sm" %>
      <%= link_to "Goals", site_goals_path(@site), class: "btn btn-sm" %>
      <%# Sharing was reachable only from the bottom of the settings form, in the
          slot the delete-style action goes in, so getting a read-only link out to
          a client meant three screens and a scroll. Sharing what is on screen is
          a thought you have while looking at it, which is here. -%>
      <% if policy(SharedLink.new(site: @site)).index? %>
        <%= link_to "Share", site_shared_links_path(@site), class: "btn btn-sm",
                    data: { analytics_event: "Share Links Opened",
                            analytics_props: { source: "dashboard_header" } } %>
      <% end %>
      <%# Which of the two routes to the snippet was taken: the header button on a
          working site is somebody re-installing or checking, the empty-state
          button below is somebody still trying to get their first event in. %>
      <%= link_to "Install", site_installation_path(@site), class: "btn btn-sm",
                  data: { analytics_event: "Install Snippet Viewed",
                          analytics_props: { source: "header" } } %>
      <%# Settings used to be reachable only from the bottom of the install page,
          which is a page you visit once and never again. Everything it holds —
          the timezone the whole dashboard is bucketed in, the k-anonymity
          threshold that decides which breakdown rows appear at all — is something
          you want while looking at the dashboard, so the link belongs here. -%>
      <% if policy(@site).update? %>
        <%= link_to "Settings", edit_site_path(@site), class: "btn btn-sm",
                    data: { analytics_event: "Site Settings Opened",
                            analytics_props: { source: "dashboard_header" } } %>
      <% end %>
    </div>
  </div>

  <% unless @site.receiving_data? %>
    <div class="notice mb-6 flex items-center justify-between gap-4">
      <span>No data yet — this site has never received an event.</span>
      <%= link_to "Show me the snippet", site_installation_path(@site), class: "btn btn-primary btn-sm",
                  data: { analytics_event: "Install Snippet Viewed",
                          analytics_props: { source: "empty_state" } } %>
    </div>
  <% end %>

  <%# The filter chips and the turbo-frame both live inside this partial, so that
      what a full page load renders and what a frame request returns are the same
      markup. They were separate, and the frame response was missing the frame. -%>
  <%= render "sites/dashboard", site: @site, report: @report,
             filters: @filters, drillable: true %>
</div>
