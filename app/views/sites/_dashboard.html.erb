<% summary = report.summary
   drillable = local_assigns.fetch(:drillable, true)
   filters = local_assigns[:filters] %>

<%# The turbo-frame lives INSIDE this partial, not around it.

    Turbo replaces a frame with the matching <turbo-frame> element found in the
    RESPONSE. sites#show answers a frame request by rendering this partial alone,
    so while the frame was wrapped around the render in show.html.erb the frame
    response contained no frame at all — and every breakdown row click, the one
    interaction this frame exists to serve, answered 200 and rendered
    "Content Missing". A full page load looked perfect, which is why it survived.
    Same lesson as installations/_status.html.erb; the frame belongs with the
    thing that gets re-rendered.

    `turbo_action: advance` because the filter state is carried entirely in the
    URL (see DashboardHelper) and that is the whole reason a filtered dashboard is
    shareable and survives the back button. A frame navigation does not touch the
    URL bar by default, which would have quietly cost all three. -%>
<%= turbo_frame_tag "dashboard", data: { turbo_action: "advance" } do %>

<%# The applied-filter chips render INSIDE the frame, because drilling into a row
    is what creates a filter and the chips are the only way to see or remove one.
    Left outside, the panels would filter and nothing on screen would say so. -%>
<% if drillable && filters %>
  <%= render "sites/filters", site: site, filters: filters %>
<% end %>

<%# --- Stat row -------------------------------------------------------------
    A strict five-column grid separated by hairlines rather than boxes: the
    grid does the work a card border would otherwise do. -%>
<div class="card mb-6">
  <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5">
    <%# The second tile is "Pageviews" except under an event filter, where the
        metric itself changes to the matching events — see DashboardHelper#volume_label. -%>
    <% [
         ["Unique visitors",       metric_number(summary.visitors),  delta_tag(summary, :visitors)],
         [volume_label(filters),   metric_number(summary.pageviews), delta_tag(summary, :pageviews)],
         ["Visits",          metric_number(summary.sessions),  delta_tag(summary, :sessions)],
         ["Bounce rate",     "#{summary.bounce_rate}%",        delta_tag(summary, :bounce_rate, lower_is_better: true)],
         ["Visit duration",  summary.formatted_duration,       delta_tag(summary, :avg_duration)]
       ].each_with_index do |(label, value, delta), index| %>
      <div class="px-5 py-5 <%= "grid-hairline" unless index.zero? %> border-t border-rule first:border-t-0 md:border-t-0">
        <p class="label"><%= label %></p>
        <p class="figure mt-2.5"><%= value %></p>
        <p class="mt-1.5"><%= delta %></p>
      </div>
    <% end %>
  </div>
</div>

<%# --- Timeseries ---------------------------------------------------------- %>
<div class="card mb-6">
  <div class="card-head">
    <h2 class="text-sm font-semibold">Traffic</h2>
    <%# Legend is always present for two series — identity must never depend on
        colour-matching alone. -%>
    <div class="flex items-center gap-5 text-[12px] text-ink-2">
      <span class="flex items-center gap-2">
        <span class="inline-block w-3 h-0.5 bg-signal" aria-hidden="true"></span>Visitors
      </span>
      <span class="flex items-center gap-2">
        <span class="inline-block w-3 h-0.5 bg-petrol" aria-hidden="true"></span><%= volume_label(filters) %>
      </span>
    </div>
  </div>
  <div class="card-body pt-6">
    <%= timeseries_chart(report.timeseries, interval: report.period.interval,
                         volume_label: volume_label(filters)) %>
  </div>
</div>

<%# --- Goals ---------------------------------------------------------------- %>
<% if report.goals.any? %>
  <div class="card mb-6">
    <div class="card-head">
      <h2 class="text-sm font-semibold">Goal conversions</h2>
<%# `_top` because this partial renders inside the "dashboard" turbo-frame on
          sites#show. Without it Turbo looks for a <turbo-frame id="dashboard"> in the
          goals page, does not find one, and replaces the dashboard with an error
          instead of navigating. The drill-down links below deliberately do NOT get
          this: they return the dashboard page, which does contain a matching frame,
          so staying in-frame is exactly what should happen. %>
      <%= link_to "Manage", site_goals_path(site), class: "label hover:text-ink",
                  data: { turbo_frame: "_top" } if drillable %>
    </div>
    <div>
      <div class="bar-row label border-b border-rule">
        <span>Goal</span>
        <span class="flex gap-8">
          <span class="w-24 text-right">Visitors</span>
          <span class="w-24 text-right">Conversions</span>
          <span class="w-16 text-right">Rate</span>
        </span>
      </div>
      <% report.goals.each do |row| %>
        <div class="bar-row">
          <span class="bar-fill" style="width: <%= row.conversion_rate.clamp(0, 100) %>%"></span>
          <span class="bar-label font-medium"><%= row.goal.name %></span>
          <span class="flex gap-8 num">
            <span class="w-24 text-right"><%= metric_number(row.visitors) %></span>
            <span class="w-24 text-right"><%= metric_number(row.conversions) %></span>
            <span class="w-16 text-right font-semibold"><%= row.conversion_rate %>%</span>
          </span>
        </div>
      <% end %>
    </div>
  </div>
<% end %>

<%# --- Breakdowns ----------------------------------------------------------- %>
<div class="grid md:grid-cols-2 gap-6">
  <% report.breakdowns.each do |panel| %>
    <%= render "sites/breakdown", site: site, panel: panel, drillable: drillable %>
  <% end %>
</div>

<%# --- Custom event properties ---------------------------------------------
    Only present when the dashboard is scoped to one custom event, because a
    property means nothing detached from the event that carried it — see
    Analytics::Dashboard#properties. `report.properties` is therefore empty on
    the ordinary dashboard and on every public shared dashboard, so this whole
    section costs nothing there.

    Given its own heading rather than being appended to the grid above: these
    rows are the customer's own data at a finer grain than anything else on the
    page, and the eight panels above are about the audience while these are
    about what the audience did. -%>
<% if report.properties.present? %>
  <div class="mt-6">
    <div class="flex items-baseline gap-3 mb-4">
      <h2 class="text-sm font-semibold">Properties</h2>
      <%# Names the event, so the panels below cannot be read as site-wide. %>
      <p class="label">sent with <%= report.filters["event"] || "these events" %></p>
    </div>

    <div class="grid md:grid-cols-2 gap-6">
      <% report.properties.each do |panel| %>
        <%= render "sites/breakdown", site: site, panel: panel, drillable: drillable %>
      <% end %>
    </div>
  </div>
<% end %>

<% end %>
