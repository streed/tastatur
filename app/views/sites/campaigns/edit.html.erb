<% content_for :title, "#{@campaign_link.name} · Campaigns · #{@site.domain}" %>

<div class="shell max-w-3xl">
  <div class="pt-5 rule-heavy mb-8">
    <h1 class="text-2xl font-semibold mt-5">Edit campaign link</h1>
    <%# Said here rather than discovered afterwards. The report matches on the
        five values, so changing one does not move history onto the new spelling
        — it points the link at a row that may have nothing in it yet, and the
        old row reappears under "Campaigns not built here". -%>
    <p class="text-sm text-ink-2 mt-2">
      Changing a tag value re-points this link at a different row. Visits already recorded stay
      under the values they arrived with, and any link already sent out still carries the old ones.
    </p>
  </div>

  <%= render "form" %>
</div>
