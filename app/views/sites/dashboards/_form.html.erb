<%# Creating a dashboard asks for a name and nothing else. The widgets are
    chosen on the dashboard itself, against real numbers, which is a better
    place to decide "is this the panel I meant" than a list of select boxes
    over a dashboard that does not exist yet.

    As with goals and funnels: creating is reported, and no field travels with
    it — a dashboard's name is the customer's own vocabulary. -%>
<%= form_with model: [@site, @dashboard], url: site_dashboards_path(@site),
              class: "card card-body space-y-6",
              data: { analytics_event: "Dashboard Created" } do |f| %>
  <%= f.error_summary %>

  <%= f.field :name, "Dashboard name", placeholder: "Marketing overview", autofocus: true,
              hint: "It opens with one stat tile. Add the rest on the dashboard." %>

  <%= f.actions "Create dashboard", cancel_to: site_dashboards_path(@site) %>
<% end %>
