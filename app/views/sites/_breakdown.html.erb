<% result = panel[:result]
   dimension = panel[:dimension]
   max = result.rows.map(&:visitors).max.to_i
   # Public shared dashboards pass drillable: false. Filtering someone else's
   # audience is a re-identification tool, so the rows are not clickable there
   # and there is no filter state to build a URL from.
   drillable = local_assigns.fetch(:drillable, true) %>

<div class="card">
  <div class="card-head">
    <h2 class="text-sm font-semibold"><%= panel[:title] %></h2>
    <span class="label">Visitors</span>
  </div>

  <% if result.any? %>
    <div>
      <% result.rows.each_with_index do |row, index| %>
        <% width = max.zero? ? 0 : ((row.visitors.to_f / max) * 100).round(1) %>

        <%# The bar is a background wash scaled to the row's share of the largest
            value, so the label and its magnitude share one line. %>
        <% bar = capture do %>
          <span class="bar-fill" style="width: <%= width %>%"></span>

          <span class="bar-label">
            <% if dimension == "country" %>
              <span class="mr-2" aria-hidden="true"><%= country_flag(row.value) %></span><%= country_name(row.value) %>
            <% else %>
              <%= row.label %>
            <% end %>
          </span>

          <span class="num font-medium shrink-0"><%= metric_number(row.visitors) %></span>
        <% end %>

        <%# Drilling in is how a filter gets applied, so it reports the dimension
            and the rank of the row within its panel — enough to learn that people
            filter by page far more than by screen size, and that they take the
            first row rather than reading down. `row.value` is emphatically NOT
            sent: it is one of the customer's own paths, referrers or countries,
            and the whole argument for this product is that we do not put such
            things in an analytics database. The public dashboards take the
            branch below and are never instrumented at all. -%>
        <% if drillable %>
          <%= link_to drill_down_url(site, dimension, row.value), class: "bar-row",
                      title: "Filter by #{row.label}",
                      data: { analytics_event: "Filter Applied",
                              analytics_props: { dimension: dimension, position: index + 1 } } do %><%= bar %><% end %>
        <% else %>
          <div class="bar-row"><%= bar %></div>
        <% end %>
      <% end %>
    </div>

    <% if result.suppressed? %>
      <%# The suppression is stated, not hidden. A site owner who cannot see a
          row deserves to know it exists and why, and stating the count keeps the
          total honest. %>
      <p class="px-3 py-2.5 text-[11px] text-muted border-t border-rule">
        <%= pluralize(result.suppressed_rows, "row") %> withheld
        (<%= metric_number(result.suppressed_visitors) %> visitors)
        because each was seen by fewer than <%= result.threshold %> visitors.
<%# `_top`: this renders inside the "dashboard" turbo-frame, and /privacy has no
            frame of that name, so an in-frame navigation would blank the dashboard. %>
        <%= link_to "Why?", privacy_path, class: "underline hover:text-ink",
                    data: { turbo_frame: "_top" } %>
      </p>
    <% end %>
  <%# EVERY row was withheld, which is not the same as having no data and must not
      say so.

      This branch used to render "No data." whenever no row survived, because the
      suppression notice above lives inside the `result.any?` arm and `any?` counts
      the rows that SURVIVED. So the one case where a site owner most needs the
      explanation — a new or quiet site where every row sits under the threshold —
      was the exact case that told them there was nothing there.

      It is also the panel contradicting the summary directly above it, which
      reports the visitors these very rows are made of. The obvious reading is that
      collection is broken. -%>
  <% elsif result.suppressed? %>
    <div class="px-5 py-8 text-center">
      <p class="text-sm text-ink-2">
        Nothing to show yet, but not because nothing happened.
      </p>
      <p class="text-[12px] text-muted mt-2 max-w-sm mx-auto leading-relaxed">
        <%= pluralize(result.suppressed_rows, "row") %> withheld
        (<%= metric_number(result.suppressed_visitors) %> visitors), because a row
        seen by fewer than <%= result.threshold %> visitors can identify the people
        in it. Rows appear here as traffic grows.
        <%# Only the owner is offered the lever. The public shared dashboard renders
            this same partial with drillable: false, and its readers can neither
            reach site settings nor should be told the threshold is adjustable. -%>
        <% if drillable %>
          You can lower the threshold in
          <%= link_to "site settings", edit_site_path(site), class: "underline hover:text-ink",
                      data: { turbo_frame: "_top" } %>.
        <% end %>
        <%= link_to "Why?", privacy_path, class: "underline hover:text-ink",
                    data: { turbo_frame: "_top" } %>
      </p>
    </div>
  <% else %>
    <p class="px-5 py-10 text-center text-sm text-muted">No data.</p>
  <% end %>
</div>
