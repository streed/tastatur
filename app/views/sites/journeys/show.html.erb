<% content_for :title, "Journeys · #{@site.domain}" %>

<%# Wider than the forms elsewhere in this section, because the map is a fixed
    pixel canvas rather than something that reflows: at 4xl the fourth column of
    a three-hop journey falls off the right-hand edge and has to be scrolled to
    on a full-size screen. See FlowMapHelper for the geometry this is sized
    against. -%>
<div class="shell max-w-6xl">
  <div class="flex flex-wrap items-end justify-between gap-4 mb-8 pt-5 rule-heavy">
    <div class="mt-5">
      <h1 class="text-2xl font-semibold">Journeys</h1>
      <p class="label mt-2">
        <%= @site.domain %><span class="mx-2">·</span><%= @period.label %>
      </p>
    </div>
    <div class="flex flex-wrap gap-3">
      <%# What counts as a step. Events are in by default because the click
          between two pages is usually the point; the other half exists for the
          site that fires one event on every page, where leaving them in means
          there is a step between every pair of pages and the shape of the site
          disappears. See Sites::JourneysController::PAGES_ONLY. -%>
      <div class="segmented">
        <%= link_to "Pages & events", journey_mode_url(@site, true),
                    class: "segment", "aria-current": @include_events.to_s,
                    data: { analytics_event: "Journey Steps Changed",
                            analytics_props: { steps: "all" } } %>
        <%= link_to "Pages only", journey_mode_url(@site, false),
                    class: "segment", "aria-current": (!@include_events).to_s,
                    data: { analytics_event: "Journey Steps Changed",
                            analytics_props: { steps: "pages" } } %>
      </div>

      <div class="segmented">
        <% %w[7d 30d 90d].each do |key| %>
          <%# `view` tells this apart from the dashboard's own period control, the
              same way the funnel page does: a flow is read over a different span
              than a traffic report and one number for both would hide that. -%>
          <%= link_to Analytics::Period::PRESETS[key].sub("Last ", ""),
                      journey_url(@site, @path, period: Analytics::Period.parse(key, site: @site)),
                      class: "segment", "aria-current": (@period.key == key).to_s,
                      data: { analytics_event: "Period Changed",
                              analytics_props: { period: key, view: "journeys" } } %>
        <% end %>
      </div>
      <%= link_to "Dashboard", site_path(@site), class: "btn btn-sm" %>
    </div>
  </div>

  <%# --- Where to start ------------------------------------------------------
      Typed, or picked. The chips below are entry pages, because that is where a
      journey usually begins — but a journey does not have to, and a report you
      can only open at one of twelve places cannot answer "what happens after
      somebody clicks this". Both lists come from Analytics::Breakdown, so both
      are k-anonymous before anything is walked: the chips through the
      controller, the picker through Analytics::KnownValues.

      A GET form, so the answer is a URL like every other state on this screen,
      and so it works with no JavaScript at all — the combobox only ever
      suggests. Submitting it starts a NEW journey at depth one, which is why it
      carries no `path[]` beyond its own: the walked path is exactly what you
      are replacing. The period and the events mode are not, so they ride along
      as hidden fields. -%>
  <div class="card mb-6">
    <div class="card-head">
      <h2 class="text-sm font-semibold">Start from</h2>
      <span class="label">Any page or custom event</span>
    </div>

    <%# The value-picker controller goes on the form rather than on the field,
        because the field and the kind select are one question: which of them is
        chosen decides whether the list is paths or event names. Same shape as
        the goal form and a funnel step's condition. -%>
    <%= form_with model: @start, scope: :start, url: site_journeys_path(@site), method: :get,
                  class: "card-body space-y-4",
                  data: { controller: "value-picker",
                          value_picker_source_value: OffersKnownValues::KNOWN_VALUES_DOM_ID } do |f| %>
      <div class="grid sm:grid-cols-[minmax(0,11rem)_1fr_auto] gap-4 items-end">
        <%# `name:` is given explicitly on both, because these two fields are one
            element of the URL's parallel `path[]` / `kind[]` arrays rather than
            an object being saved. See Analytics::FlowStep. -%>
        <%= f.field :kind, "Kind", as: :select, name: "kind[]",
                    choices: [["Page", Analytics::FlowStep::PAGEVIEW],
                              ["Custom event", Analytics::FlowStep::EVENT]],
                    data: { value_picker_target: "kind",
                            action: "change->value-picker#kindChanged" } %>
        <%= f.field :value, "Page or event name", as: :combobox, name: "path[]",
                    placeholder: "/pricing" %>
        <button type="submit" class="btn mb-0.5"
                data-analytics-event="Journey Started">Show journey</button>
      </div>

      <% journey_mode_param.merge(@period.to_param).each do |key, value| %>
        <%= hidden_field_tag key, value, id: nil %>
      <% end %>

      <%# Said in the same voice as the goal and funnel forms (see
          sites/_known_values_note), and for the same reason: on a quiet site at
          the default threshold every row is withheld and the picker opens onto
          nothing, which without this sentence reads as "this site has no
          pages". -%>
      <p class="text-[12px] text-muted">
        <% if known_values.any? %>
          Pick from the <%= pluralize(known_values.paths.size, "page") %> and
          <%= pluralize(known_values.events.size, "custom event") %> recorded in the last
          <%= pluralize(known_values.days, "day") %>, or type anything else.
        <% else %>
          Nothing recorded in the last <%= pluralize(known_values.days, "day") %>,
          so there is nothing to pick from yet.
        <% end %>
        <% if known_values.withheld? %>
          <%= pluralize(known_values.withheld, "value") %>
          <%= known_values.withheld == 1 ? "is" : "are" %> not listed because
          <%= known_values.withheld == 1 ? "it was" : "they were" %> seen by fewer than
          <%= known_values.threshold %> visitors, this site's privacy threshold.
        <% end %>
      </p>
    <% end %>

    <% if @start_pages.any? %>
      <div class="card-body border-t border-rule flex flex-wrap gap-2 items-center">
        <span class="label mr-1">Where visits begin</span>
        <% @start_pages.rows.each do |row| %>
          <% active = @path.first == Analytics::FlowStep.page(row.value) %>
          <%= link_to row.label, journey_url(@site, [Analytics::FlowStep.page(row.value)]),
                      class: "segment #{'font-semibold' if active}",
                      "aria-current": active.to_s,
                      data: { analytics_event: "Journey Started" } %>
        <% end %>
      </div>
    <% end %>
  </div>

  <%= render "sites/known_values_payload" %>

  <% if @levels.any? %>
    <%# --- The map -----------------------------------------------------------
        The same data as the cards below, drawn as the tree it actually is. See
        FlowMapHelper for why both are on the page: the picture carries the
        shape, the lists carry the figures and the prose that has to be exact.

        Nil when there is nothing to draw — a start step nobody went anywhere
        from — in which case the walked path falls back to the text breadcrumb
        below, which is the only thing left that can be stepped back through. -%>
    <% flow = flow_map(@site, @path, @levels) %>

    <% if flow %>
      <div class="card mb-6">
        <div class="card-head">
          <h2 class="text-sm font-semibold">
            Where visitors go from <%= flow_step_label(@path.first) %>
          </h2>
          <span class="label">Line weight is the share taking that route</span>
        </div>
        <%# Padded vertically only. The canvas centres itself and scrolls when it
            is wider than the card, so side padding would just be dead margin
            inside the scroll area — and on a phone it is the difference between
            two columns fitting and one. -%>
        <div class="py-4 px-2"><%= flow %></div>

        <%# The one sentence a reader needs to have BEFORE looking at the
            picture, rather than after the three cards below it. "Immediately
            next" is the whole difference between this report and the funnel,
            and a reader who assumes otherwise misreads every edge on screen.
            The longer note at the foot of the page is the rest of it. -%>
        <p class="px-5 py-3 text-[12px] text-muted border-t border-rule leading-relaxed">
          Each line is what visitors did <em>immediately</em> next, within the same visit — not
          merely somewhere later on, which is what a funnel measures. Its weight and its
          percentage are the share of the visitors at that node who took it, so the lines
          leaving one node add up to 100%. Click any step to see what happened after it.
        </p>
      </div>
    <% end %>

    <%# The text breadcrumb that used to sit here is gone, and the map's spine is
        why: it steps back to any hop in one click exactly as the breadcrumb did,
        and says how many visitors are still on each one. It is not a fallback
        either — every walked step is drawn, including one no branch accounts
        for, so a path deeper than the start step always has a spine to click.
        The only way to have no map is a start step with nothing after it, where
        there was never anything to step back through. -%>

    <%# The same tree as a list, level by level. Not a duplicate for its own
        sake: it carries the exact figures, both suppression wordings and the
        three-state distinction between "nobody went anywhere" and "we are not
        telling you where they went" — prose that has to be read, which is not
        something a picture can do. It is also the rendering that survives with
        no CSS, and the accessible reading of the map above. -%>
    <% if flow %>
      <p class="label mb-3">Level by level</p>
    <% end %>

    <div class="space-y-6">
      <% @levels.each_with_index do |result, depth| %>
        <div class="card">
          <div class="card-head">
            <h2 class="text-sm font-semibold">
              After <%= flow_path_label(@path.first(depth + 1)) %>
            </h2>
            <span class="label"><%= pluralize(metric_number(result.visitors), "visitor") %> here</span>
          </div>

          <%= render "sites/flow_branches", site: @site, result: result,
                     expandable: depth < Analytics::PageFlow::MAX_DEPTH - 1,
                     chosen: @path[depth + 1] %>
        </div>
      <% end %>
    </div>

    <% if @path.size >= Analytics::PageFlow::MAX_DEPTH %>
      <p class="notice mt-6">
        This is as deep as the tree goes. Six hops is already further than a report stays
        readable, and each one divides the crowd again — start from a page further along
        instead to see what happens after it.
      </p>
    <% end %>

    <%# The rest of the reading rules. The "immediately next" half of this moved
        up beside the map, where a reader needs it before looking rather than
        after — repeating it here would be the third time on one screen. -%>
    <p class="text-[12px] text-muted mt-6 max-w-2xl leading-relaxed">
      Each row is what visitors did immediately next, within the same visit. Percentages are
      shares of the visitors at that point and add up to 100%. Repeats of the same step in a row
      are treated as one, so a reload is not a journey and neither is a double-clicked button.
      <% if @include_events %>
        A step is a page view or a custom event; an event that fired on the page you were
        already on is a step of its own, between that page and the next.
      <% else %>
        Only page views are steps in this view. Custom events — the clicks between the pages —
        are left out until you switch them on above.
      <% end %>
    </p>

  <%# No start page to open with. Two quite different reasons, and telling them
      apart is the whole point — one is a quiet site, the other is a suppressed
      one, and "No data." for both would be a lie half the time. -%>
  <% elsif @start_pages.suppressed? %>
    <div class="card card-body text-center py-14">
      <p class="font-semibold">Nothing to show yet, but not because nothing happened.</p>
      <p class="text-sm text-ink-2 mt-2 max-w-md mx-auto leading-relaxed">
        <%= pluralize(@start_pages.suppressed_rows, "entry page") %> withheld
        (<%= metric_number(@start_pages.suppressed_visitors) %> visitors), because a page seen by
        fewer than <%= @start_pages.threshold %> visitors can identify the people who saw it. A
        journey narrows the crowd further at every hop, so this report needs more traffic than the
        dashboard does before it can show anything.
      </p>
      <div class="mt-6">
        <%= link_to "Site settings", edit_site_path(@site), class: "btn btn-sm" %>
      </div>
    </div>
  <% else %>
    <div class="card card-body text-center py-14">
      <p class="font-semibold">No journeys yet.</p>
      <p class="text-sm text-ink-2 mt-2 max-w-md mx-auto leading-relaxed">
        Once visits arrive, this shows what people did next from any page or event — the home
        page to pricing, the pricing page to a Signup click — one hop at a time.
      </p>
      <div class="mt-6">
        <%= link_to "Dashboard", site_path(@site), class: "btn btn-quiet" %>
      </div>
    </div>
  <% end %>
</div>
