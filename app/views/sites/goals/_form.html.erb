<%= form_with model: [@site, @goal],
              url: @goal.persisted? ? site_goal_path(@site, @goal) : site_goals_path(@site),
              class: "card card-body space-y-6" do |f| %>
  <%= f.error_summary %>

  <%= f.field :name, "Name", placeholder: "Signup completed", autofocus: true %>

  <div>
    <span class="label block mb-2">What counts as a conversion</span>
    <div class="space-y-2">
      <div class="border border-rule-2 p-3 hover:bg-surface-2">
        <label class="flex items-start gap-3 cursor-pointer">
          <%= f.radio_button :kind, "pageview", class: "mt-1" %>
          <span>
            <span class="font-medium text-sm">A page was viewed</span>
            <span class="block text-[12px] text-muted mt-0.5">Matches the request path, e.g. /pricing</span>
          </span>
        </label>
      </div>
      <div class="border border-rule-2 p-3 hover:bg-surface-2">
        <label class="flex items-start gap-3 cursor-pointer">
          <%= f.radio_button :kind, "event", class: "mt-1" %>
          <span>
            <span class="font-medium text-sm">A custom event fired</span>
            <span class="block text-[12px] text-muted mt-0.5">
              Matches an event name sent with <code>tastatur('event', 'Name')</code>
            </span>
          </span>
        </label>
      </div>
    </div>
  </div>

  <div class="grid sm:grid-cols-3 gap-4">
    <%= f.field :match_value, "Path or event name", placeholder: "/pricing",
                wrapper: "sm:col-span-2" %>
    <%= f.field :match_type, "Match", as: :select,
                choices: [["Exactly", "exact"], ["Starts with", "prefix"], ["Wildcard", "wildcard"]] %>
  </div>

  <p class="text-[12px] text-muted -mt-2">
    Wildcards: <code>*</code> matches within one path segment, <code>**</code> matches across
    segments. <code>/blog/**</code> matches every post.
  </p>

  <div class="grid sm:grid-cols-3 gap-4 rule pt-6">
    <%= f.field :default_value_cents, "Value in minor units (optional)", as: :number_field,
                min: 0, placeholder: "4900", wrapper: "sm:col-span-2" %>
    <%= f.field :currency, "Currency", placeholder: "EUR", maxlength: 3 %>
  </div>

  <%= f.actions @goal.persisted? ? "Save goal" : "Create goal",
                cancel_to: site_goals_path(@site),
                destructive: (@goal.persisted? ? button_to("Delete", site_goal_path(@site, @goal), method: :delete, class: "btn btn-quiet text-negative", form: { data: { turbo_confirm: "Delete this goal? Its historical conversions stay in the raw data." } }) : nil) %>
<% end %>
