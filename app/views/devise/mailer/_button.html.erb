<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 24px;">
  <tr>
    <td style="background-color:#c1440e;">
      <a href="<%= url %>"
         style="display:inline-block; padding:12px 22px; font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;
                font-size:14px; font-weight:600; color:#ffffff; text-decoration:none;"><%= label %></a>
    </td>
  </tr>
</table>

<p style="margin:0 0 8px; font-size:11px; font-weight:600; letter-spacing:1.6px; text-transform:uppercase; color:#8c8a80;">
  Or paste this into your browser
</p>
<p style="margin:0 0 24px; font-size:12px; line-height:1.5; word-break:break-all;">
  <a href="<%= url %>" style="color:#00628f;"><%= url %></a>
</p>
