<% content_for :subject, "Reset your password" %>
<% content_for :preheader, "This link expires in a few hours." %>

<h1 style="margin:0 0 16px; font-size:21px; font-weight:600; letter-spacing:-0.4px; line-height:1.2; color:#16150f;">
  Reset your password
</h1>

<p style="margin:0 0 20px; color:#57564e;">
  Someone asked to reset the password for this address. Choose a new one here.
</p>

<%= render "devise/mailer/button",
           url: edit_password_url(@resource, reset_password_token: @token),
           label: "Choose a new password" %>

<p style="margin:0; padding-top:20px; border-top:1px solid #e3e1d8; font-size:13px; color:#8c8a80;">
  If you did not ask for this, ignore this email. Your password stays as it is
  and nobody gains access. The link stops working shortly.
</p>
