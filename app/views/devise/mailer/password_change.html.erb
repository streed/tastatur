<% content_for :subject, "Your password was changed" %>
<% content_for :preheader, "A security notice, no action needed if this was you." %>

<h1 style="margin:0 0 16px; font-size:21px; font-weight:600; letter-spacing:-0.4px; line-height:1.2; color:#16150f;">
  Your password was changed
</h1>

<p style="margin:0 0 16px; color:#57564e;">
  The password for <strong style="color:#16150f;"><%= @resource.email %></strong>
  was just changed.
</p>

<p style="margin:0; padding-top:20px; border-top:1px solid #e3e1d8; font-size:13px; color:#8c8a80;">
  If that was you, nothing to do. If it was not, reset your password now, because
  someone else may have access to your account.
</p>
