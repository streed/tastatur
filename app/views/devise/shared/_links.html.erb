<%# Every Devise screen gets the same link row, and each link hides itself on the
    page it already points at. %>
<% if controller_name != "sessions" %>
  <%= link_to "Sign in", new_session_path(resource_name), class: "hover:text-ink underline" %>
<% end %>

<% if devise_mapping.registerable? && controller_name != "registrations" && Tastatur.allow_signup? %>
  <%= link_to "Create an account", new_registration_path(resource_name), class: "hover:text-ink underline" %>
<% end %>

<% if devise_mapping.recoverable? && !%w[passwords registrations].include?(controller_name) %>
  <%= link_to "Forgot your password?", new_password_path(resource_name), class: "hover:text-ink underline" %>
<% end %>

<% if devise_mapping.confirmable? && controller_name != "confirmations" %>
  <%= link_to "Resend confirmation", new_confirmation_path(resource_name), class: "hover:text-ink underline" %>
<% end %>

<% if devise_mapping.lockable? && resource_class.unlock_strategy_enabled?(:email) && controller_name != "unlocks" %>
  <%= link_to "Resend unlock instructions", new_unlock_path(resource_name), class: "hover:text-ink underline" %>
<% end %>
