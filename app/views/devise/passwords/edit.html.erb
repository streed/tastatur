<% content_for :title, "Choose a new password · Tastatur" %>

<%= render layout: "devise/shared/auth_card",
           locals: { title: "Choose a new password" } do %>
  <%# `turbo: false` so a password manager is offered the new password — the
      whole point of arriving here is that the saved one is wrong, and a reset
      that does not update the manager leaves somebody locked out by the thing
      that was supposed to let them back in. See devise/shared/_auth_card for the
      mechanism.

      "Password Reset Completed" went to Users::PasswordsController with it. It
      fires only when the token was still valid AND the new password was
      accepted — against "Password Reset Requested", that is how many people the
      emailed link actually got back in — and it was reported from
      `turbo:submit-end`, which a form that has opted out never emits. Devise
      signs them in from here and that sign-in is still deliberately not counted
      as one: it is the recovery path, not the funnel. -%>
  <%= form_for(resource, as: resource_name, url: password_path(resource_name),
               html: { method: :put, class: "card card-body space-y-5",
                       data: { turbo: false } }) do |f| %>
    <%= f.error_summary %>
    <%= f.hidden_field :reset_password_token %>
    <%= f.field :password, "New password", as: :password_field, autofocus: true,
                autocomplete: "new-password",
                hint: "At least #{@minimum_password_length} characters." %>
    <%= f.field :password_confirmation, "Confirm new password", as: :password_field,
                autocomplete: "new-password" %>
    <div class="pt-1">
      <%= f.submit "Set new password", class: "btn btn-primary w-full justify-center" %>
    </div>
  <% end %>
<% end %>
