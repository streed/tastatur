<% content_for :title, "Choose a new password · Tastatur" %>

<%= render layout: "devise/shared/auth_card",
           locals: { title: "Choose a new password" } do %>
  <%# The far end of the reset: fires only when the token was still valid and the
      new password was accepted, so this against "Password Reset Requested" is
      how many people the emailed link actually got back in. Devise signs them in
      from here, and that sign-in is deliberately not counted as one — it is the
      recovery path, not the funnel. %>
  <%= form_for(resource, as: resource_name, url: password_path(resource_name),
               html: { method: :put, class: "card card-body space-y-5",
                       data: { analytics_event: "Password Reset Completed" } }) do |f| %>
    <%= f.error_summary %>
    <%= f.hidden_field :reset_password_token %>
    <%= f.field :password, "New password", as: :password_field, autofocus: true,
                autocomplete: "new-password",
                hint: "At least #{@minimum_password_length} characters." %>
    <%= f.field :password_confirmation, "Confirm new password", as: :password_field,
                autocomplete: "new-password" %>
    <div class="pt-1">
      <%= f.submit "Set new password", class: "btn btn-primary w-full justify-center" %>
    </div>
  <% end %>
<% end %>
