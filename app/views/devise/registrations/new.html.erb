<% content_for :title, "Create an account · Tastatur" %>

<%= render layout: "devise/shared/auth_card",
           locals: { title: "Create an account",
                     subtitle: "You will be measuring your first site a minute from now." } do %>
  <%# Two annotations still, because the gap between them is the number worth
      having: the button counts every attempt, and "Account Created" counts only
      the sign-ups the server accepted. The difference is how many people the
      form turned away, which a pageview of this screen cannot tell you — a
      failed sign-up comes back as a 422 re-render at the same URL and never
      produces a second pageview.

      THE SECOND ONE IS NO LONGER ON THIS FORM. It used to be, and it was
      reported from `turbo:submit-end`, which does not fire once a form opts out
      of Turbo — and this one has to, so a password manager can offer to save the
      password somebody just chose (see the note in devise/shared/_auth_card).
      Leaving it here would have deleted the metric silently, which is the exact
      failure mode this codebase keeps writing specs about. It is recorded by
      Users::RegistrationsController instead, where the answer to "did it
      succeed" is not a guess. -%>
  <%= form_for(resource, as: resource_name, url: registration_path(resource_name),
               html: { class: "card card-body space-y-5",
                       data: { turbo: false } }) do |f| %>
    <%= f.error_summary %>

    <%= f.field :name, "Your name", autofocus: true, autocomplete: "name" %>
    <%= f.field :email, "Email", as: :email_field, autocomplete: "email" %>
    <%= f.field :password, "Password", as: :password_field, autocomplete: "new-password",
                hint: "At least #{@minimum_password_length} characters." %>
    <%= f.field :password_confirmation, "Confirm password", as: :password_field,
                autocomplete: "new-password" %>

    <div class="pt-1">
      <%= f.submit "Create account", class: "btn btn-primary w-full justify-center",
                   data: { analytics_event: "Sign Up Submitted" } %>
    </div>

    <p class="text-[12px] text-muted">
      We store your email so you can sign in, and nothing else about you.
      <%= link_to "What we collect from your visitors", privacy_path, class: "underline hover:text-ink" %>.
    </p>
  <% end %>
<% end %>
