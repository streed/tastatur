<% content_for :title, "Your account · Tastatur" %>

<%= render layout: "devise/shared/auth_card",
           locals: { title: "Your login details" } do %>
  <%= form_for(resource, as: resource_name, url: registration_path(resource_name),
               html: { method: :put, class: "card card-body space-y-5" }) do |f| %>
    <%= f.error_summary %>

    <%= f.field :name, "Your name", autocomplete: "name" %>
    <%= f.field :email, "Email", as: :email_field, autocomplete: "email" %>

    <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
      <div class="notice">
        Waiting on confirmation of <%= resource.unconfirmed_email %>. Until you confirm it, signing
        in still uses your previous address.
      </div>
    <% end %>

    <div class="rule pt-5 space-y-5">
      <%= f.field :password, "New password", as: :password_field, autocomplete: "new-password",
                  hint: "Leave blank to keep your current password." %>
      <%= f.field :password_confirmation, "Confirm new password", as: :password_field,
                  autocomplete: "new-password" %>
      <%= f.field :current_password, "Current password", as: :password_field,
                  autocomplete: "current-password",
                  hint: "Required to change your email address or password." %>
    </div>

    <div class="pt-1">
      <%= f.submit "Save changes", class: "btn btn-primary w-full justify-center" %>
    </div>
  <% end %>
<% end %>
