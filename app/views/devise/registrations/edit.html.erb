<% content_for :title, "Your account · Tastatur" %>

<%= render layout: "devise/shared/auth_card",
           locals: { title: "Your login details" } do %>
  <%# THE FORM A PASSWORD MANAGER HAS TO SEE MOST OF ALL. Somebody who changes
      their password here and is not offered an update keeps a stale one saved,
      and finds out at the next sign-in — on the screen that no longer accepts
      it. So it opts out of Turbo like the other credential forms, which is what
      makes the submission a navigation the manager can observe. See
      devise/shared/_auth_card.

      "Login Details Updated" moved to Users::RegistrationsController with it: it
      counted only the saves that went through, it was reported from
      `turbo:submit-end`, and that event does not fire on a form that has opted
      out. Which field was edited is still deliberately not recorded — "this
      person changed their email address" is a fact about a person, and one prop
      naming the field is all it would take to start keeping those. -%>
  <%= form_for(resource, as: resource_name, url: registration_path(resource_name),
               html: { method: :put, class: "card card-body space-y-5",
                       data: { turbo: false } }) do |f| %>
    <%= f.error_summary %>

    <%= f.field :name, "Your name", autocomplete: "name" %>
    <%= f.field :email, "Email", as: :email_field, autocomplete: "email" %>

    <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
      <div class="notice">
        Waiting on confirmation of <%= resource.unconfirmed_email %>. Until you confirm it, signing
        in still uses your previous address.
      </div>
    <% end %>

    <div class="rule pt-5 space-y-5">
      <%= f.field :password, "New password", as: :password_field, autocomplete: "new-password",
                  hint: "Leave blank to keep your current password." %>
      <%= f.field :password_confirmation, "Confirm new password", as: :password_field,
                  autocomplete: "new-password" %>
      <%= f.field :current_password, "Current password", as: :password_field,
                  autocomplete: "current-password",
                  hint: "Required to change your email address or password." %>
    </div>

    <div class="pt-1">
      <%= f.submit "Save changes", class: "btn btn-primary w-full justify-center" %>
    </div>
  <% end %>
<% end %>
