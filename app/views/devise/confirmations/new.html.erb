<% content_for :title, "Resend confirmation · Tastatur" %>

<%= render layout: "devise/shared/auth_card",
           locals: { title: "Resend confirmation",
                     subtitle: "Enter the address you signed up with." } do %>
  <%# "Requested" rather than "Resent", because paranoid mode means this screen
      answers the same way for an address that has no account, and the event must
      not know more than the screen does. Against "Account Created" it says how
      often the first confirmation mail failed to arrive or was lost. %>
  <%= form_for(resource, as: resource_name, url: confirmation_path(resource_name),
               html: { method: :post, class: "card card-body space-y-5",
                       data: { analytics_event: "Confirmation Requested" } }) do |f| %>
    <%= f.error_summary %>
    <%= f.field :email, "Email", as: :email_field, autofocus: true, autocomplete: "email" %>
    <div class="pt-1">
      <%= f.submit "Resend confirmation", class: "btn btn-primary w-full justify-center" %>
    </div>
  <% end %>
<% end %>
