<% content_for :title, "AI agents · #{@account.name}" %>

<div class="shell max-w-3xl">
  <div class="pt-5 rule-heavy mb-8">
    <h1 class="text-2xl font-semibold mt-5">Connect an AI agent to <%= @account.name %></h1>
    <p class="text-sm text-ink-2 mt-2">
      Let an assistant such as Claude read your traffic, goals, funnels, campaigns and revenue
      attribution through the Model Context Protocol. One key covers
      <%= @sites.any? ? "all #{pluralize(@sites.size, 'site')} in this account" : "every site in this account" %>,
      the same ones you can already see. The agent can read and nothing else: it cannot change
      anything, it cannot see any other account, and small rows stay withheld exactly as on your
      dashboard. Anyone in your organisation can connect one.
    </p>
  </div>

  <% if flash[:api_key] %>
    <%# SHOWN EXACTLY ONCE, from the flash. See Sites::ApiKeysController. -%>
    <div class="notice mb-6" data-controller="clipboard">
      <p class="text-sm font-semibold">Copy this now. It is not shown again.</p>
      <div class="flex items-center gap-3 mt-3">
        <code class="font-mono text-xs break-all" data-clipboard-target="source"><%= flash[:api_key] %></code>
        <button type="button" class="btn btn-sm" data-action="clipboard#copy"
                data-clipboard-target="label">Copy</button>
      </div>
    </div>
  <% end %>

  <%= form_with model: @api_key, url: account_mcp_keys_path, class: "card card-body space-y-6" do |f| %>
    <%= f.error_summary %>
    <h2 class="text-sm font-semibold">1. Make a key</h2>
    <%= f.field :name, "Label", placeholder: "claude on my laptop",
                hint: "What will use it. The key is yours: it stops working if you leave the organisation." %>
    <%= f.actions "Create key", cancel_to: account_path, cancel_label: "Back to account" %>
  <% end %>

  <div class="card mt-8">
    <div class="card-head"><h2 class="text-sm font-semibold">2. Add the server to your client</h2></div>
    <div class="card-body text-sm space-y-3">
<pre class="text-xs overflow-x-auto"><code>claude mcp add --transport http tastatur <%= Tastatur.base_url %>/mcp \
  --header "Authorization: Bearer tk_..."</code></pre>
      <p class="text-ink-2">
        Any MCP client that speaks Streamable HTTP takes the same two things: the URL
        <code><%= Tastatur.base_url %>/mcp</code> and an <code>Authorization: Bearer</code> header carrying the key.
        Ask the agent to start with <code>list_sites</code>. Limited to 60 requests a minute per key.
      </p>
    </div>
  </div>

  <% if @api_keys.any? %>
    <div class="card mt-8">
      <div class="card-head"><h2 class="text-sm font-semibold">Keys</h2></div>
      <% @api_keys.each do |key| %>
        <div class="px-5 py-4 border-b border-rule last:border-b-0 flex items-start justify-between gap-4">
          <div class="min-w-0">
            <p class="text-sm font-medium">
              <%= key.name %>
              <% if key.revoked? %><span class="label ml-2">Revoked</span><% end %>
            </p>
            <p class="label mt-1 font-mono"><%= key.masked %></p>
            <p class="label mt-1">
              <% if key.user_id != current_user.id %>Made by <%= key.user&.email %> · <% end %>
              <% if key.revoked? %>
                Revoked <%= time_ago_in_words(key.revoked_at) %> ago
              <% elsif key.last_used_at %>
                Last used <%= time_ago_in_words(key.last_used_at) %> ago
              <% else %>
                Never used
              <% end %>
            </p>
          </div>
          <% if key.live? && policy(key).destroy? %>
            <%= button_to "Revoke", account_mcp_key_path(key), method: :delete, class: "btn btn-sm",
                          form: { data: { turbo_confirm: "Revoke #{key.name}? The agent using it stops working immediately." } } %>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
