<% content_for :title, "Admin · Tastatur" %>
<% counts = @summary.counts
   health = @summary.health %>

<div class="shell">
  <%= render "admin/nav" %>

  <%# --- The instance, in numbers -------------------------------------------
      Accounts, people, sites. Deliberately nothing about anybody's audience:
      there is no visitor figure on this page and no way to reach one, because
      those belong to a customer's visitors rather than to us. The event count is
      a capacity number — rows arriving — not a fact about a person. -%>
  <div class="card mb-6">
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5">
      <% [
           ["Users", metric_number(counts.users)],
           ["Accounts", metric_number(counts.accounts)],
           ["Sites", metric_number(counts.sites)],
           ["Events · 24h", metric_number(counts.events_24h)],
           ["Signups · 7d", metric_number(counts.signups_7d)]
         ].each_with_index do |(label, value), index| %>
        <div class="px-5 py-5 <%= "grid-hairline" unless index.zero? %> border-t border-rule first:border-t-0 md:border-t-0">
          <p class="label"><%= label %></p>
          <p class="figure mt-2.5"><%= value %></p>
        </div>
      <% end %>
    </div>
  </div>

  <div class="grid md:grid-cols-2 gap-6 mb-6">
    <%# --- Things that need a person ------------------------------------------
        Each row is a number AND the way to act on it. A count of locked accounts
        with no route to the people in it is a statistic; this is a worklist. -%>
    <div class="card">
      <div class="card-head"><h2 class="text-sm font-semibold">Needs attention</h2></div>
      <div>
        <% [
             ["Unconfirmed emails", counts.unconfirmed,
              "Cannot sign in until confirmed. Usually a bounced or filtered email.",
              admin_users_path],
             ["Locked accounts", counts.locked,
              "Locked by repeated failed sign-ins. Unlock rather than telling somebody to wait.",
              admin_users_path],
             ["Sites awaiting first event", counts.sites_awaiting_data,
              "Snippet added but nothing received. The most common reason someone writes in.",
              admin_sites_path]
           ].each do |label, count, blurb, path| %>
          <div class="flex items-start justify-between gap-4 px-5 py-4 border-b border-rule last:border-b-0">
            <div>
              <p class="text-sm font-medium"><%= label %></p>
              <p class="text-[12px] text-muted mt-1 max-w-sm leading-relaxed"><%= blurb %></p>
            </div>
            <div class="text-right shrink-0">
              <p class="figure num <%= "text-muted" if count.zero? %>"><%= metric_number(count) %></p>
              <%= link_to "Open", path, class: "label hover:text-ink underline" if count.positive? %>
            </div>
          </div>
        <% end %>
      </div>
    </div>

    <%# --- Moving parts --------------------------------------------------------
        The four things whose silent failure this codebase has already been bitten
        by: an unserved queue, an unflushed buffer, a missing salt, an absent geo
        database. Each one fails without raising, so each one gets a light. -%>
    <div class="card">
      <div class="card-head"><h2 class="text-sm font-semibold">Moving parts</h2></div>
      <div>
        <%= render "admin/health_row",
                   label: "Visitor salt",
                   ok: health.salt,
                   value: health.salt ? "present" : "missing",
                   blurb: "Held only in the non-persistent Redis. Without it, ingest cannot compute an identity at all." %>

        <%= render "admin/health_row",
                   label: "GeoIP database",
                   ok: health.geoip,
                   value: health.geoip ? "loaded" : "absent",
                   blurb: health.geoip ? "Country breakdowns are enabled." : "Country breakdowns will be empty. Run tastatur:geoip:download." %>

        <% buffer = health.buffer_depth %>
        <%= render "admin/health_row",
                   label: "Write buffer",
                   ok: buffer != :unavailable,
                   value: buffer == :unavailable ? "unreachable" : "#{metric_number(buffer)} pending",
                   blurb: "Events waiting in Redis to be written. A number that only grows means the flush job is not running." %>

        <% queues = health.queues %>
        <div class="px-5 py-4 border-b border-rule last:border-b-0">
          <div class="flex items-center justify-between gap-4">
            <p class="text-sm font-medium">Queues</p>
            <%= link_to "Sidekiq →", "/sidekiq", class: "label hover:text-ink underline" %>
          </div>
          <% if queues == :unavailable %>
            <p class="text-[12px] text-negative mt-2">Redis unreachable.</p>
          <% elsif queues.empty? %>
            <p class="text-[12px] text-muted mt-2">No queues reporting — no worker has started yet.</p>
          <% else %>
            <%# Depth per SLA tier. The tiers are drained in strict priority order,
                so a number here is only alarming relative to what the tier
                promises: 400 in within_1_hour is nightly bulk, 400 in
                within_5_seconds is somebody staring at a signup screen. %>
            <div class="mt-3 space-y-1.5">
              <% queues.sort.each do |name, size| %>
                <div class="flex items-center justify-between gap-4 text-[12px]">
                  <span class="text-ink-2 font-mono"><%= name %></span>
                  <span class="num <%= size.zero? ? "text-muted" : "font-semibold" %>"><%= metric_number(size) %></span>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <%# --- Recent signups ------------------------------------------------------- %>
  <div class="card">
    <div class="card-head">
      <h2 class="text-sm font-semibold">Recent signups</h2>
      <%= link_to "All people", admin_users_path, class: "label hover:text-ink underline" %>
    </div>
    <% if @summary.recent_users.any? %>
      <div>
        <% @summary.recent_users.each do |user| %>
          <%= link_to admin_user_path(user),
                      class: "flex items-center justify-between gap-4 px-5 py-3.5 border-b border-rule last:border-b-0 hover:bg-surface-2" do %>
            <div class="min-w-0">
              <p class="text-sm font-medium truncate"><%= user.email %></p>
              <p class="label mt-1">
                <%= user.accounts.first&.name || "no account" %>
                <span class="mx-2">·</span><%= time_ago_in_words(user.created_at) %> ago
              </p>
            </div>
            <div class="flex items-center gap-2 shrink-0">
              <% unless user.confirmed? %>
                <span class="chip"><span class="chip-key">unconfirmed</span></span>
              <% end %>
              <% if user.locked? %>
                <span class="chip"><span class="chip-key">locked</span></span>
              <% end %>
              <% if user.admin? %>
                <span class="chip"><span class="chip-key">admin</span></span>
              <% end %>
            </div>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <p class="px-5 py-10 text-center text-sm text-muted">Nobody has signed up yet.</p>
    <% end %>
  </div>
</div>
