<%# One support action: what it does, why you would, and the button.

    A disabled action states WHY it is unavailable rather than rendering a dead
    control. "Confirm" greyed out with no explanation is indistinguishable from a
    broken page. -%>
<% disabled_note = local_assigns[:disabled_note] %>
<%# POST unless told otherwise. The two-factor action is a DELETE because it only
    ever removes — see Admin::UserPolicy#disable_two_factor?. -%>
<% method = local_assigns.fetch(:method, :post) %>
<% confirm = local_assigns[:confirm] %>
<div class="flex items-start justify-between gap-4 px-5 py-4 border-b border-rule last:border-b-0">
  <div>
    <p class="text-sm font-medium"><%= label %></p>
    <p class="text-[12px] text-muted mt-1 max-w-lg leading-relaxed"><%= blurb %></p>
  </div>
  <div class="shrink-0">
    <% if disabled %>
      <span class="label"><%= disabled_note %></span>
    <% else %>
      <%= button_to button, path, method: method, class: "btn btn-sm",
                    form: confirm ? { data: { turbo_confirm: confirm } } : {} %>
    <% end %>
  </div>
</div>
