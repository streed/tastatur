#!/usr/bin/env bash
# Run the spec suite inside the dev container against the test database.
#
#   bin/dspec                          # everything
#   bin/dspec spec/lib                 # a directory
#   bin/dspec spec/models/site_spec.rb:42
#
# The test database and Redis databases are separate from development, so this
# never touches your dev data.
set -euo pipefail
cd "$(dirname "$0")/.."

exec docker compose exec -T \
  -e RAILS_ENV=test \
  -e DATABASE_URL=postgres://postgres:postgres@timescaledb:5432/tastatur_test \
  -e REDIS_URL=redis://redis:6379/1 \
  -e REDIS_PRIVACY_URL=redis://redis-privacy:6379/1 \
  web bundle exec rspec "$@"
