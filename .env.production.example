# Copy to .env.production and fill in. Used by docker-compose.prod.yml.
# Every available setting is documented in docs/self-hosting/configuration.md

# --- Required ----------------------------------------------------------------

# Public hostname. Caddy requests a Let's Encrypt certificate for it, so its DNS
# must already point at this host.
APP_DOMAIN=analytics.example.com
APP_HOST=analytics.example.com

# Generate with:
#   docker compose -f docker-compose.prod.yml run --rm web bin/rails secret
SECRET_KEY_BASE=

# Choose a strong password, then use the SAME value in both lines below. The
# compose file does no variable substitution (see the note at the top of
# docker-compose.prod.yml), so the connection string is spelled out in full.
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://postgres:change-me@timescaledb:5432/tastatur_production

# Service names on the compose network, using the INTERNAL ports.
REDIS_URL=redis://redis:6379/0
REDIS_PRIVACY_URL=redis://redis-privacy:6379/0

# --- Deployment mode ---------------------------------------------------------

# Removes billing entirely: Stripe is never touched and no plan limits apply.
SELF_HOSTED=1

# Public registration. Defaults to OFF when self-hosted so an internet-exposed
# instance cannot be signed up to by strangers. Set to 1 to open it.
ALLOW_SIGNUP=0

# --- TLS ---------------------------------------------------------------------
# Both Railway and the bundled Caddy terminate TLS in front of the app, so leave
# these at 1. Only change them if your proxy does NOT terminate TLS; see
# docs/self-hosting/configuration.md#tls for what breaks either way.
ASSUME_SSL=1
FORCE_SSL=1

# --- Legal identity ----------------------------------------------------------
# The privacy policy at /privacy-policy and the terms at /terms are templates.
# Until ENTITY, EMAIL and JURISDICTION are set, both pages render a visible
# "not configured" banner rather than publishing a document that names nobody.
# Have your own counsel review them before relying on them.

LEGAL_ENTITY=
LEGAL_ADDRESS=
LEGAL_EMAIL=
LEGAL_JURISDICTION=
LEGAL_DPO_EMAIL=

# The date you last revised /privacy-policy and /terms, as YYYY-MM-DD.
# Left blank the pages show no date, which is better than the previous behaviour:
# they rendered Date.current and so claimed to have been updated today, every day.
LEGAL_UPDATED_ON=

# --- Email -------------------------------------------------------------------
# Only needed for confirmations, password resets and team invitations.

MAIL_FROM=no-reply@example.com
RESEND_API_KEY=

# --- Billing -----------------------------------------------------------------
#
# IRRELEVANT WHEN SELF_HOSTED=1, which is the default in this file. A self-hosted
# install has no plans, no event or site limits and no upgrade interface, and never
# contacts Stripe. Leave all four blank.
#
# On a hosted deployment the app logs an error at boot for any missing one it reads
# (all but the publishable key, which nothing loads).
# STRIPE_WEBHOOK_SECRET is the one whose absence fails
# invisibly: without it the webhook endpoint refuses every delivery, so a
# subscription is paid for and never applied. See docs/architecture/billing.md

# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_PRO=

# --- Revenue attribution (Stripe app) ----------------------------------------
#
# A SEPARATE Stripe integration from billing, pointing the other way: it lets a
# site owner connect their own Stripe account, read-only, so the attribution
# screen can show which channel produced paying customers. Works self-hosted —
# it is deliberately not gated on billing. Leave blank and the feature is
# simply absent.
#
# Set up by uploading the app in stripe-app/ (see docs/self-hosting/configuration.md).
# STRIPE_SECRET_KEY above is also required: connected-account calls are made
# with it. The webhook secret is a DIFFERENT secret from STRIPE_WEBHOOK_SECRET,
# from a "Connected accounts" endpoint at /stripe/connect/webhook — and it is
# the one whose absence fails invisibly: connecting works, history imports,
# and then no ongoing revenue is ever recorded.

# STRIPE_CONNECT_CLIENT_ID=
# STRIPE_CONNECT_WEBHOOK_SECRET=
# Only when the Stripe App is owned by a different account than billing's;
# falls back to STRIPE_SECRET_KEY when unset.
# STRIPE_CONNECT_SECRET_KEY=

# --- Optional ----------------------------------------------------------------

# Error reporting. Leave blank to disable.
SENTRY_DSN=

# Ingest tuning. Raise the flush size under high volume so each INSERT covers
# more events. This is the lever that actually helps.
# INGEST_FLUSH_SIZE=250
# SESSION_TIMEOUT_MINUTES=30

# --- Concurrency, and why raising it is usually the wrong lever ---------------
#
# SIDEKIQ_CONCURRENCY does NOT raise ingest throughput. Measured on 150,000
# buffered events: 6.85 s to flush at concurrency 5, and 8.39 s at 15. The
# multi-row INSERT is the bottleneck, so extra threads only add contention. It
# also sizes only Sidekiq's own Redis pool and leaves the ActiveRecord pool at
# RAILS_MAX_THREADS, so raising it far enough exhausts database connections
# instead of going faster.
# SIDEKIQ_CONCURRENCY=5

# Web process and thread counts. The constraint to respect:
#
#   WEB_CONCURRENCY x RAILS_MAX_THREADS + SIDEKIQ_CONCURRENCY < max_connections
#
# `WEB_CONCURRENCY=auto` resolves to the host's core count, which is a trap on a
# large machine: 24 cores x 3 threads + 5 is 77 connections from one deployment,
# and a stock PostgreSQL offers about 97 in total. It will not fail at boot,
# because ActiveRecord pools are lazy — it fails later as intermittent
# `FATAL: too many connections` under load, which is a much worse way to find out.
# WEB_CONCURRENCY=2
# RAILS_MAX_THREADS=3
#
# Note RAILS_MAX_THREADS must not be set to an empty string. `bundle exec sidekiq`
# reads it with Integer() and crashes at boot on "".

# --- A warning about REDIS_PRIVACY_URL ---------------------------------------
#
# It is set above and points at a Redis running WITHOUT persistence, which holds
# the rotating visitor salt. docker-compose.prod.yml wires that instance with
# `--save "" --appendonly no` and declares no volume. (The redis image declares
# VOLUME /data itself, so an empty anonymous one exists regardless; the flags are
# what make the guarantee, so verify with: ls -1 /data | wc -l -> 0)
#
# Do not point it at your persistent Redis. That writes the salt to disk, where
# it will end up in a backup next to the events it would de-anonymise, and a
# restore would bring it back. The application logs a warning at boot if you
# leave it unset, and the unlinkability claim on your privacy page stops being
# true either way.
#
# See docs/privacy/identity.md and docs/self-hosting/operations.md
