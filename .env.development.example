
# Copy to .env.development (bin/dev-setup does this for you).
# Ports match docker-compose.yml.

DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5455/tastatur_development
REDIS_URL=redis://127.0.0.1:6389/0
APP_HOST=localhost:3000
MAIL_FROM=no-reply@tastatur.com
RESEND_API_KEY=re_xxx
SENTRY_DSN=

# Legal identity for the hosted instance. On a self-hosted install these name
# whoever is running it, which is not Reedster. See docs/self-hosting/configuration.md
LEGAL_ENTITY=Reedster LLC
LEGAL_EMAIL=privacy@reedster.llc
LEGAL_JURISDICTION=the State of Washington, USA

# Stripe — fill these in once your product is set up in the Stripe dashboard
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
