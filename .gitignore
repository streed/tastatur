# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files generated by your text editor or operating system
# belong in git's global ignore instead:
# `$XDG_CONFIG_HOME/git/ignore` or `~/.config/git/ignore`

# Ignore bundler config.
/.bundle

# Ignore all environment files.
/.env*

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

/public/assets

# Ignore key files for decrypting credentials and more.
/config/*.key


# dotenv
.env
.env.*.local
.env.development
.env.test
# .env.production holds SECRET_KEY_BASE, the database password and API keys.
# The starter template did not ignore it by name; committing it would publish
# every secret a self-hosted instance has.
.env.production

# ...but the .example templates MUST be committed. Rails' own `/.env*` rule
# above is broad enough to swallow them, which would silently break the
# documented setup step (`cp .env.production.example .env.production`) for
# anyone cloning the repository. Negations have to come after the rule they
# override, so they live here at the end.
!/.env.development.example
!/.env.test.example
!/.env.production.example

/app/assets/builds/*
!/app/assets/builds/.keep

# Third-party country database, fetched by `rails tastatur:geoip:download`.
# Deliberately not vendored: it carries its own licence and is republished
# monthly, so a committed copy would ship stale forever.
/db/geoip/*.mmdb

stripe-app/.build/

# Editions: Rails engines kept in their own repositories and loaded by
# config/application.rb when present. The hosted service clones its edition to
# editions/private; this repository is the community edition and is complete
# without any of them. Ignored as a directory rather than by name so a second
# edition cannot be committed here by accident — which is the whole point, since
# a private file committed to a public history stays in it.
/editions/
